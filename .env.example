VITE_ORBI_PAY_GATEWAY_BASE_URL=https://sandbox-pay.orbifinancial.com
VITE_ORBI_PORTAL_ENVIRONMENT=sandbox

# Temporary local role adapter until Auth/BFF provides session claims.
# public_developer | developer | operator | admin
VITE_ORBI_PORTAL_ACTOR_ROLE=public_developer

# Internal/operator portal access. Do not expose production operator keys in a public browser build.
VITE_ORBI_PORTAL_OPERATOR_KEY=

# Optional: service key used only for service-profile/runtime testing from trusted internal builds.
VITE_ORBI_PAY_SERVICE_KEY=
